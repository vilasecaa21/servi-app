<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>SERVI - Marketplace de Servicios Locales</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Login / Logout / Registro -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.servi.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.servi.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/registro</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.servi.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Servicios -->
    <servlet>
        <servlet-name>ServiciosServlet</servlet-name>
        <servlet-class>com.servi.servlet.ServiciosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServiciosServlet</servlet-name>
        <url-pattern>/servicios</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PublicarServicioServlet</servlet-name>
        <servlet-class>com.servi.servlet.PublicarServicioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PublicarServicioServlet</servlet-name>
        <url-pattern>/publicar-servicio</url-pattern>
    </servlet-mapping>

    <!-- Trabajos -->
    <servlet>
        <servlet-name>TrabajosServlet</servlet-name>
        <servlet-class>com.servi.servlet.TrabajosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TrabajosServlet</servlet-name>
        <url-pattern>/trabajos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PublicarTrabajoServlet</servlet-name>
        <servlet-class>com.servi.servlet.PublicarTrabajoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PublicarTrabajoServlet</servlet-name>
        <url-pattern>/publicar-trabajo</url-pattern>
    </servlet-mapping>

    <!-- Perfil -->
    <servlet>
        <servlet-name>PerfilServlet</servlet-name>
        <servlet-class>com.servi.servlet.PerfilServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PerfilServlet</servlet-name>
        <url-pattern>/perfil</url-pattern>
    </servlet-mapping>

    <!-- Chat -->
    <servlet>
        <servlet-name>ChatServlet</servlet-name>
        <servlet-class>com.servi.servlet.ChatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatServlet</servlet-name>
        <url-pattern>/chat</url-pattern>
    </servlet-mapping>

    <!-- Wallet -->
    <servlet>
        <servlet-name>WalletServlet</servlet-name>
        <servlet-class>com.servi.servlet.WalletServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WalletServlet</servlet-name>
        <url-pattern>/wallet</url-pattern>
    </servlet-mapping>

    <!-- Valoraciones -->
    <servlet>
        <servlet-name>ValoracionServlet</servlet-name>
        <servlet-class>com.servi.servlet.ValoracionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ValoracionServlet</servlet-name>
        <url-pattern>/valoracion</url-pattern>
    </servlet-mapping>

    <!-- Detalle de servicio / trabajo -->
    <servlet>
        <servlet-name>DetalleServicioServlet</servlet-name>
        <servlet-class>com.servi.servlet.DetalleServicioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DetalleServicioServlet</servlet-name>
        <url-pattern>/servicio</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DetalleTrabajoServlet</servlet-name>
        <servlet-class>com.servi.servlet.DetalleTrabajoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DetalleTrabajoServlet</servlet-name>
        <url-pattern>/trabajo</url-pattern>
    </servlet-mapping>

    <!-- Session timeout: 30 minutos -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>
</web-app>
